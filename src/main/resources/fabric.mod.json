{
  "schemaVersion": 1,
  "id": "controller-ce",
  "version": "${version}",
  "name": "Controller CE",
  "description": "Native gamepad/controller support for Better Than Wolves CE with analog movement, camera look, modern button mappings, and virtual cursor navigation in menus.",
  "authors": [
    "chronicboy31"
  ],
  "contact": {
    "homepage": "https://github.com/chronicboy/controller-ce",
    "sources": "https://github.com/chronicboy/controller-ce"
  },
  "license": "CC0-1.0",
  "icon": "assets/controller-ce/icon.png",
  "environment": "client",
  "entrypoints": {
    "main": [
      "btw.community.chronicboy.controller.ControllerMod"
    ],
    "btw:addon": [
      "btw.community.chronicboy.controller.ControllerAddon"
    ]
  },
  "custom": {
    "btw:addon_prefix": "CTRL"
  },
  "mixins": [
    "controller-ce.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.14.19",
    "minecraft": "1.6.4"
  }
}
